<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NodeApiAssemblyJSModuleType>commonjs</NodeApiAssemblyJSModuleType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PackageId>CriusNyx.DevCon</PackageId>
    <Version>0.0.1</Version>
    <Authors>CriusNyx</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Outdir>bin</Outdir>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CriusNyx.Result" Version="0.0.9" />
    <PackageReference Include="CriusNyxUtil" Version="0.0.20" />
    <PackageReference Include="Microsoft.JavaScript.NodeApi" Version="0.9.17" />
    <PackageReference Include="Microsoft.JavaScript.NodeApi.Generator" Version="0.9.17" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Superpower" Version="3.1.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="package.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\XDoc.NET\src\Render\XDoc.PlainText\XDoc.PlainText.csproj" />
    <ProjectReference Include="..\XDoc.NET\src\XDoc\XDoc.csproj" />
  </ItemGroup>
  <!-- <ItemGroup>
    <ProjectReference Include="..\XDoc.NET\src\XDoc\XDoc.csproj" />
    <ProjectReference Include="..\XDoc.NET\src\Render\XDoc.PlainText\XDoc.PlainText.csproj" />
  </ItemGroup> -->
</Project>
